# ─── observable-mlops-platform — Environment Variables ────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is in .gitignore.
#
# Usage (docker-compose):
#   cp .env.example .env
#   docker compose --env-file .env up
# ──────────────────────────────────────────────────────────────────────────────

# ── Self-Healing ──────────────────────────────────────────────────────────────
# Set to false to enable live K8s remediation (requires kubeconfig)
SELF_HEALING_DRY_RUN=true

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
# For DagsHub remote tracking:
# MLFLOW_TRACKING_URI=https://dagshub.com/<org>/<repo>.mlflow
DAGSHUB_TOKEN=

# ── DVC / DagsHub ────────────────────────────────────────────────────────────
DAGSHUB_USER=
DAGSHUB_REPO=

# ── PostgreSQL (Airflow + MLflow backend) ─────────────────────────────────────
# REQUIRED: Change all passwords before any non-local deployment
POSTGRES_USER=mlops
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=mlops_platform
MLFLOW_DB_URI=postgresql://mlops:CHANGE_ME_postgres_password@postgres:5432/mlops_platform

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_run_python_c_from_cryptography_fernet_import_Fernet_print_Fernet_generate_key_decode
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://mlops:CHANGE_ME_postgres_password@postgres:5432/mlops_platform
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME_airflow_web_secret
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=CHANGE_ME_airflow_admin_password

# ── n8n workflow automation ───────────────────────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key_32chars

# ── OPA ───────────────────────────────────────────────────────────────────────
OPA_URL=http://opa:8181
# OPA bundle signing (optional, for production bundle verification)
OPA_BUNDLE_SIGNING_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENDPOINT=http://otelcol:4318
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin
PROMETHEUS_URL=http://prometheus:9090

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ── Ollama / LLM ─────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=tinyllama

# ── AWS (for EKS / S3 DVC remote / Karpenter) ─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_DVC_REMOTE=s3://your-mlops-dvc-bucket/dvc-store

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Service flags ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=local
SERVICE_VERSION=0.2.0
